# ──────────────────────────────────────────────────────────────────────────────
# Database (postgres.js connection string)
# Examples:
#   Local:    postgresql://postgres:password@localhost:5432/travel_db
#   Neon:     postgresql://user:pass@ep-xxx.neon.tech/travel_db?sslmode=require
#   Supabase: postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/travel_db"

# ──────────────────────────────────────────────────────────────────────────────
# Auth.js (NextAuth v5)
# Generate secret: openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────────────
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# OAuth Providers (add as needed)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ──────────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
